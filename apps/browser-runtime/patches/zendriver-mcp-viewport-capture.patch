+    // A Chrome-created tab can initially report an emulated viewport larger
+    // than its compositor surface. Use a clipped capture only to settle that
+    // surface after an ordinary PNG proves the dimensions do not match. Normal
+    // captures must remain unclipped: Chrome omits top-layer menus and dialogs
+    // when captureBeyondViewport is enabled.
+    let viewport_clip = if !input.full_page && input.selector.is_none() && input.format == ImgFormat::Png {
+        let metrics = tab.session().call("Page.getLayoutMetrics", json!({}))
+            .await.map_err(|e| map_error(McpServerError::from(ZendriverError::from(e))))?;
+        let viewport = metrics.get("cssLayoutViewport").ok_or_else(|| {
+            ErrorData::internal_error("Missing screenshot viewport", None)
+        })?;
+        let number = |key: &str| -> Result<f64, ErrorData> {
+            viewport.get(key).and_then(serde_json::Value::as_f64)
+                .filter(|n| n.is_finite())
+                .ok_or_else(|| ErrorData::internal_error("Invalid screenshot viewport", None))
+        };
+        let (x, y, width, height) = (number("pageX")?, number("pageY")?,
+            number("clientWidth")?, number("clientHeight")?);
+        if x < 0.0 || y < 0.0 || width <= 0.0 || height <= 0.0 || width > 2048.0 || height > 2048.0 {
+            return Err(ErrorData::invalid_params("Screenshot viewport exceeds bounds", None));
+        }
+        Some(zendriver::BoundingBox { x, y, width, height })
+    } else { None };

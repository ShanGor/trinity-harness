# Copy to .env for local development. Never commit real secrets.

# --- PostgreSQL (local testing env, drizzle-kit migrate target) ---
DATABASE_URL=postgresql://trinity_harness:trinity_harness@localhost:5432/trinity_harness

# --- Redis 7+ (M2: event bus / BullMQ / SSE relay; distributed mode) ---
REDIS_URL=redis://localhost:6379

# --- Auth (M2: required when DATABASE_URL is set) ---
# HMAC signing key for bearer tokens (min 16 chars, keep secret).
TOKEN_SECRET=change-me-in-production-0123456789
# First-boot bootstrap admin (used only while the users table is empty).
ADMIN_EMAIL=admin@trinity.local
ADMIN_PASSWORD=change-me-too-0123456789

# --- LLM providers (server-side only; never sent to the frontend) ---
# Anthropic
ANTHROPIC_API_KEY=
# Optional custom endpoint (proxy / gateway):
#ANTHROPIC_BASE_URL=
# OpenAI (used when MODEL starts with "openai/")
OPENAI_API_KEY=
#OPENAI_BASE_URL=

# --- Agent model (server) ---
# Format: "provider/model-id", routed by the gateway.
MODEL=anthropic/claude-sonnet-4-20250514
# MiniMax China preset (use your MiniMax key as ANTHROPIC_API_KEY):
#MODEL=anthropic/MiniMax-M3.1-Flash
#ANTHROPIC_BASE_URL=https://api.minimax.cn/anthropic/v1
#MODEL_CONTEXT_TOKENS=1000000
# Thinking is required and enabled by default; leave REASONING_BUDGET_TOKENS unset.
# CNY pay-as-you-go prices are bundled in config/models.yaml.
# Reasoning (optional, provider-specific):
# Anthropic extended thinking budget in tokens:
#REASONING_BUDGET_TOKENS=4096
# OpenAI reasoning effort: none|minimal|low|medium|high|xhigh|max
#REASONING_EFFORT=medium

# --- Server (optional, defaults shown) ---
#PORT=3000
#HOST=127.0.0.1
#WORKSPACE_ROOT=/path/to/workspace
# SYSTEM_PROMPT overrides the built-in general-purpose, task-adaptive default.
# SYSTEM_PROMPT=You are Trinity, a general-purpose assistant.
# Optional per-agent model-step limit (1..1024); unset is unlimited.
# When configured, the last step is reserved for answering.
#MAX_TURN_STEPS=64
# Model limits must match your routed model; no automatic model catalog lookup.
#MODEL_CONTEXT_TOKENS=200000
#MODEL_OUTPUT_TOKENS=8192
#COMPACTION_CONTEXT_TOKENS=200000
# Optional shared parent/child/summary/retry ceilings; unset is unlimited
# for each dimension independently (see design §6.1.1).
#TASK_MAX_REQUESTS=128
#TASK_MAX_TOKENS=2000000
#TASK_MAX_DURATION_MS=1800000
# Optional original-currency ceiling; rates still come from config/models.yaml.
#TASK_MAX_COST=USD:1.50

# --- M3: permissions & approvals ---
# Default permission policy for new sessions: preset name
# (workspace-write | read-only | danger-full-access) or a JSON policy.
#DEFAULT_PERMISSION_POLICY=workspace-write

# --- M3: acp-gateway (stdio ACP for Zed etc.) ---
# Base URL of the server exposing the ACP HTTP binding.
#ACP_SERVER_URL=http://127.0.0.1:3000
# Bearer token for the server (from POST /api/auth/login).
#ACP_TOKEN=

# --- M4: context manager (compaction, docs/design.md §5.1/§7) ---
# Projected-context budget; over budget the oldest whole exchanges are
# summarized into a compaction/summary log event (in-place surface replace).
#CONTEXT_MAX_TOKENS=160000
# Target recent context during rolling checkpoint compaction; user/instructions stay pinned.
#CONTEXT_KEEP_TOKENS=40000
# Optional dedicated summarizer model (defaults to MODEL).
#COMPACTION_MODEL=

# --- M4: tool-result spill (docs/design.md §7) ---
# Results above this size are stored in the BlobStore; the log keeps a
# blob:// reference + preview (retrievable via the read_blob tool).
#SPILL_THRESHOLD_BYTES=50000

# --- M4: LSP (docs/design.md §9) ---
# Lazy per-workspace language servers: Python (pyright-langserver),
# TS/JS (typescript-language-server), JSON, YAML. Disabled ⇒ lsp_* tools
# are not registered.
#LSP_ENABLED=true
#LSP_MAX_SERVERS=4

# --- M5: sandbox hardening (docs/design.md §12.3) ---
# 'minimal' (default) scrubs server secrets from the env of spawned shells /
# language servers (PATH/HOME/LANG/TZ/TMPDIR only). 'inherit' keeps the legacy
# full-passthrough for local debugging only — never in deployed environments.
#SANDBOX_ENV_MODE=minimal

# --- M5: observability (docs/design.md §17) ---
# OTLP/gRPC endpoint for traces + metrics (e.g. http://localhost:4317); unset
# keeps instrumentation as no-ops.
#OTEL_EXPORTER_OTLP_ENDPOINT=
# Alternatively expose Prometheus /metrics on this port per workload.
#OTEL_PROMETHEUS_PORT=

# Runtime instruction skills: optional administrator-owned roots (JSON array).
# Bundled skills/ and the session's .trinity/skills, .agents/skills, .claude/skills
# are discovered automatically. Configure the same roots on server and worker.
SKILL_DIRS=[]

# Explicit opt-in: attach browser tasks to a user-owned debugging Chrome.
# CDP attachment shares that Chrome's cookies; use a dedicated trusted deployment.
# Enables typed live reading. Unset means saved reads only; managed Chrome is not launched.
# Authenticated use is restricted to this owner's personal sessions; defaults to ADMIN_EMAIL.
# BROWSER_CDP_OWNER_ID=<owner-user-uuid>
# No automatic discovery of a host browser occurs when this is unset.
# BROWSER_CDP_ENDPOINT=9222

# Alternative: managed Zendriver, with BROWSER_CDP_ENDPOINT removed/unset.
# Run pnpm start:browser-runtime separately; PostgreSQL and shared workspace storage are required.
# Current managed mode is restricted to the same configured owner's personal sessions.
# BROWSER_DRIVER=zendriver
# BROWSER_RUNTIME_ENDPOINT=http://127.0.0.1:3010
# BROWSER_RUNTIME_TOKEN=<random-secret-at-least-32-characters>
# Required on the browser-runtime process; use an encrypted persistent volume mounted only there.
# BROWSER_PROFILE_DIR=/opt/local/browser-data
# ZENDRIVER_BINARY=/absolute/path/to/patched/zendriver-mcp
# ZENDRIVER_CHROME_VERSION=155.0.8059.84
# BROWSER_RUNTIME_PORT=3010
# BROWSER_RUNTIME_MAX_SESSIONS=4
# BROWSER_RUNTIME_IDLE_MS=300000

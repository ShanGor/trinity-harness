# syntax=docker/dockerfile:1
# trinity-harness agent-worker (Agent Loop + tools + LSP). Runs the turn
# queue consumer; scales horizontally (docs/design.md §16 HPA/KEDA).
FROM node:22-slim AS deps
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile

FROM node:22-slim
WORKDIR /repo
ENV NODE_ENV=production
COPY --from=deps /repo /repo
USER node
CMD ["pnpm", "--filter", "@trinity-harness/agent-worker", "start"]

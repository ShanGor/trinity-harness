# syntax=docker/dockerfile:1
# trinity-harness web: builds the React/antd SPA and serves it with nginx,
# proxying /api + /acp to the server service (SSE-friendly, see nginx conf).
FROM node:22-slim AS build
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @trinity-harness/web build

FROM nginx:1.27-alpine
COPY deploy/docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 80

# syntax=docker/dockerfile:1
# trinity-harness audit-consumer (docs/design.md §13/§16): consumes the
# `audit` stream into audit_log. Stateless, at-least-once, idempotent writes.
FROM node:22-slim AS deps
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile

FROM node:22-slim
WORKDIR /repo
ENV NODE_ENV=production
COPY --from=deps /repo /repo
USER node
CMD ["pnpm", "--filter", "@trinity-harness/audit-consumer", "start"]

# syntax=docker/dockerfile:1
# trinity-harness server (Fastify API + SSE relay + /acp HTTP binding).
# Apps run from TypeScript source via tsx (repo convention), so the image
# carries the workspace install.
FROM node:22-slim AS deps
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile

FROM node:22-slim
WORKDIR /repo
ENV NODE_ENV=production
COPY --from=deps /repo /repo
EXPOSE 3000
USER node
CMD ["pnpm", "--filter", "@trinity-harness/server", "start"]

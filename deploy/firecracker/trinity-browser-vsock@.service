[Unit]
Description=Trinity browser host-only vsock proxy
Requires=trinity-browser.service
After=trinity-browser.service

[Service]
User=trinity-browser
Group=trinity-browser
ExecStart=/usr/local/libexec/trinity-vsock-host-proxy
StandardInput=socket
StandardOutput=socket
StandardError=null
NoNewPrivileges=yes
PrivateNetwork=yes

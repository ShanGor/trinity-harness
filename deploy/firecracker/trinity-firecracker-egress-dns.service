[Unit]
Description=Trinity Firecracker DNS relay to the host resolver
Requires=trinity-firecracker-egress.service
After=trinity-firecracker-egress.service network-online.target

[Service]
Type=forking
User=dnsmasq
Group=nogroup
RuntimeDirectory=trinity-firecracker-egress-dns
RuntimeDirectoryMode=0750
ExecStartPre=/usr/sbin/dnsmasq --test --no-hosts --no-poll --resolv-file=/etc/resolv.conf --interface=trinity-egress0 --bind-interfaces --listen-address=172.29.240.1 --local-service --cache-size=1000
PIDFile=/run/trinity-firecracker-egress-dns/dnsmasq.pid
ExecStart=/usr/sbin/dnsmasq --no-hosts --no-poll --resolv-file=/etc/resolv.conf --interface=trinity-egress0 --bind-interfaces --listen-address=172.29.240.1 --local-service --cache-size=1000 --pid-file=/run/trinity-firecracker-egress-dns/dnsmasq.pid
TimeoutStartSec=15
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

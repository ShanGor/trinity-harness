# Copy to /etc/trinity/node-agent.env. This file is root-owned and mode 0600.
# Use a URL-encoded PostgreSQL password if it contains reserved URI characters.
DATABASE_URL=REPLACE_WITH_CONTROL_DATABASE_URL
NODE_RUNTIME_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS
NODE_ID=local-kvm-01
NODE_STATE_DIR=/srv/trinity-node
NODE_DEPLOYMENT_MODE=development
NODE_STORAGE_ENCRYPTION=none
NODE_GUEST_ROUTING=true
NODE_PORT=3030
WORKSPACE_ROOT=/workspace
